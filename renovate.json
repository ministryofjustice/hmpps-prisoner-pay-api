{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ministryofjustice/hmpps-renovate-config:jvm"],
  "prBodyTemplate": "{{{table}}}{{{notes}}}{{{warnings}}}{{{controls}}}",
  "reviewers": ["natclamp-moj", "Kristian-Gregory", "davidthomas22", "munslowl", "AlexYoungmanMoJ", "mitchell-dsilva", "ashleygyngell"],
  "packageRules": [
    {
      "matchManagers": ["gradle"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non major Gradle dependencies",
      "groupSlug": "all-gradle-minor-patch"
    },
    {
      "description": "Hold swagger-ui at the version springdoc 3.2.0 supports",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["org.webjars:swagger-ui"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        "**/.github/workflows/**/*.ya?ml",
        "**/.github/actions/**/*.ya?ml"
        ]
    }
  ]
}
